<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.mvgrafx.Planetary</id>
  <name>Planetary</name>
  <summary>Remote client for Transmission, qBittorrent, and Deluge</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="net.mvgrafx">
    <name>Mark Veinot</name>
  </developer>
  <description>
    <p>
      Planetary is a native desktop client for remotely managing Transmission,
      qBittorrent, and Deluge servers.
    </p>
  </description>
  <launchable type="desktop-id">planetary.desktop</launchable>
  <provides>
    <binary>Planetary</binary>
  </provides>
  <url type="homepage">https://planetary.mvgrafx.net</url>
  <url type="bugtracker">https://github.com/mveinot/transmission-control/issues</url>
  <content_rating type="oars-1.1" />
</component>
